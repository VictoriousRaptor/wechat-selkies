#!/bin/bash

# Wayland mode autostart (Labwc compositor)
# Runs instead of /defaults/autostart when PIXELFLUX_WAYLAND=true

# populate ~/Desktop with application shortcuts (copy once, skip if already present)
mkdir -p "$HOME/Desktop"
[ -f /usr/share/applications/wechat.desktop ]   && cp -n /usr/share/applications/wechat.desktop   "$HOME/Desktop/"
[ -f /usr/share/applications/chromium.desktop ] && cp -n /usr/share/applications/chromium.desktop "$HOME/Desktop/"
[ -f /usr/share/applications/qq.desktop ]       && cp -n /usr/share/applications/qq.desktop       "$HOME/Desktop/"

# initialise tint2 config (copy default on first run, then sync launcher entries every start)
if [ ! -f "$HOME/.config/tint2/tint2rc" ]; then
    mkdir -p "$HOME/.config/tint2"
    cp /defaults/tint2rc "$HOME/.config/tint2/tint2rc"
fi
# sync qq launcher entry: add if QQ installed, remove if not
if [ -f /usr/share/applications/qq.desktop ]; then
    grep -q 'launcher_item_app.*qq\.desktop' "$HOME/.config/tint2/tint2rc" || \
        sed -i '/launcher_item_app.*chromium/a launcher_item_app = /usr/share/applications/qq.desktop' "$HOME/.config/tint2/tint2rc"
else
    sed -i '/launcher_item_app.*qq\.desktop/d' "$HOME/.config/tint2/tint2rc"
fi
nohup tint2 > /dev/null 2>&1 &

# configure labwc: ensure wechat/qq have serverDecoration=no to prevent double title bars
# The baseimage creates rc.xml before autostart runs, so we patch rather than create
LABWC_RC="$HOME/.config/labwc/rc.xml"
if [ -f "$LABWC_RC" ]; then
    for app in wechat qq; do
        grep -q "identifier=\"${app}\"" "$LABWC_RC" || \
            sed -i "/<\/windowRules>/i\    <windowRule identifier=\"${app}\" serverDecoration=\"no\" />" "$LABWC_RC"
    done
fi

# register chromium as default URL handler
gio mime x-scheme-handler/http chromium.desktop
gio mime x-scheme-handler/https chromium.desktop
gio mime application/x-terminal-emulator foot.desktop

# Start WeChat in Wayland session if auto-start is enabled
if [ "$AUTO_START_WECHAT" = "true" ]; then
    if [ -f /usr/bin/wechat ]; then
        nohup /usr/bin/wechat --ozone-platform=wayland > /dev/null 2>&1 &
    fi
fi

# Start QQ in Wayland session if auto-start is enabled
if [ "$AUTO_START_QQ" = "true" ]; then
    if [ -f /usr/bin/qq ]; then
        nohup /usr/bin/qq --no-sandbox > /dev/null 2>&1 &
    fi
fi

wait
